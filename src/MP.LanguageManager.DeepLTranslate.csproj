<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <PropertyGroup>
    <Title>MP.LanguageManager.DeepLTranslate</Title>
    <PackageId>MP.LanguageManager.DeepLTranslate</PackageId>
	  <Authors>
		  Matt Pallatt
	  </Authors>
    <Version>1.1.0</Version>
    <Description>An extension for EPiServer.Labs.LanguageManager to allow for translations through DeepL.</Description>
    <PackageTags>Optimizely LanguageManager DeepL Translations</PackageTags>
    <PackageProjectUrl>https://github.com/mattpallatt/MP.LanguageManager.DeepLTranslate
    </PackageProjectUrl>
    <RepositoryUrl>https://github.com/mattpallatt/MP.LanguageManager.DeepLTranslate</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>Adds support for Optimizely CMS 13 (.NET 10, Language Manager 6) alongside CMS 12.</PackageReleaseNotes>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DeepL.net" Version="1.10.0" />
  </ItemGroup>
  <!-- CMS 12 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="EPiServer.Labs.LanguageManager" Version="[5.3.0, 6.0.0)" />
    <PackageReference Include="EPiServer.CMS.UI" Version="[12.31.2, 13.0.0)" />
  </ItemGroup>
  <!-- CMS 13 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="EPiServer.Labs.LanguageManager" Version="[6.0.0, 7.0.0)" />
    <PackageReference Include="EPiServer.CMS.UI" Version="[13.0.1, 14.0.0)" />
  </ItemGroup>
  <ItemGroup>
    <None Update="README.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="img\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
</Project>